# Installed by debium (config-system).
# Override: same file name in /etc/udev/rules.d/
# (a link to /dev/null there disables it).

# BFQ for SATA/USB disks and SD/eMMC keeps the desktop responsive while a
# disk is busy. NVMe keeps "none". bfq loads on demand.
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", \
    KERNEL=="sd*[!0-9]|mmcblk*[0-9]", ATTR{queue/scheduler}="bfq"
